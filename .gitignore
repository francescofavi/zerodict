# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/

# Build artifacts
dist/
build/
.coverage
htmlcov/

# All hidden directories (starts with .)
.*/

# Symlinks to out-of-tree dev caches/venvs (not matched by .*/ rule above)
.mypy_cache
.venv

# Keep .gitignore, .github, and .internal_docs
!.gitignore
!.github/
!.internal_docs/

# Hidden files to ignore
.DS_Store
.coverage
.env
.run.sh
.setup.sh
.setup.bat
.check_quality.py

# Other files
*.swp
*.swo
*.log
*.bak

# Virtual environments (non-hidden)
env/
venv/
/.scripts/

# Lock files (library, not application)
uv.lock
